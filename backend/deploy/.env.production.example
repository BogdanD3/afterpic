APP_NAME="Photo Gallery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=photo_gallery
DB_USERNAME=photo_gallery
DB_PASSWORD=

SESSION_DRIVER=file
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=180
FILESYSTEM_DISK=local

FRONTEND_URL=https://frontend.example.com
TRUSTED_PROXIES=127.0.0.1

PHOTOS_MAX_UPLOAD_KB=51200
PHOTOS_MAX_PIXELS=60000000
PHOTOS_UPLOAD_RATE_LIMIT=30
PHOTOS_RETENTION_ENABLED=true
PHOTOS_RETENTION_DAYS=30
PHOTOS_DISK_WARNING_PERCENT=90
# Long random string. Leave empty to turn admin actions (deleting photos) off.
PHOTOS_ADMIN_TOKEN=
