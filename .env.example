# Copy to .env and fill in. Never commit .env.

# Public URL guests will open, exactly as it appears in the browser (include the port if not 443).
APP_URL=https://your-machine.your-tailnet.ts.net:11444

# Generate with:
#   docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=

# Host port on 127.0.0.1 that your Nginx proxies to.
APP_PORT=9002

DB_DATABASE=photo_gallery
DB_USERNAME=photo_gallery
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Optional
# PHOTOS_UPLOAD_RATE_LIMIT=30
# PHOTOS_MAX_UPLOAD_KB=51200
# PHOTOS_MAX_PIXELS=60000000
# PHOTOS_DOWNLOAD_MAX_EDGE=3000
# PHOTOS_DOWNLOAD_QUALITY=90
# PHOTOS_KEEP_ORIGINALS=false

# Photos older than this many days are deleted every night (row and files).
# Set PHOTOS_RETENTION_ENABLED=false to keep everything, e.g. during a long event.
# PHOTOS_RETENTION_ENABLED=true
# PHOTOS_RETENTION_DAYS=30
# The hourly disk check logs a warning when the disk is at least this full.
# PHOTOS_DISK_WARNING_PERCENT=90

# Admin token for deleting photos (open the gallery with ?admin=TOKEN once).
# Leave empty to turn admin actions off.
# PHOTOS_ADMIN_TOKEN=
